# Google AI Studio (https://aistudio.google.com/apikey)
# Puedes indicar varias claves separadas por comas para rotarlas en caso de 429
GOOGLE_API_KEY=tu_api_key_de_google_ai_studio
# GOOGLE_API_KEYS=clave1,clave2

# Modelo de Gemini a usar
GOOGLE_MODEL=gemini-3.8-flash

# Opcional. En los modelos Gemini 3 los parámetros de muestreo están
# desaconsejados; si se deja vacío no se envía la temperatura.
GOOGLE_TEMPERATURE=

# Tokens máximos de salida (el mapa 50x50 necesita bastante)
GOOGLE_MAX_TOKENS=32768
